# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Markdown personal settings
/markdown.xml
# Ignored default folder with query files
/queries/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
/*.iml
# Laravel plugin's project settings: the source directory it found, and the per-project flag
# beside it. The IDE writes both when the project is opened, and neither is work this package
# carries — a file no commit carries is a pending file to the handoff note.
/laravel-idea.xml
/laravel-idea-personal.xml
