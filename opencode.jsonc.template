{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md",
        "BEHAVE.mdc"
    ],
    "formatter": true,
    // `.agents/skills/` is the single real skill target (see .agents/README.md).
    // There is deliberately no `.opencode/skills/` - a second copy would drift
    // out of sync with the canonical packages, which is what it used to do.
    "skills": [
        ".agents/skills"
    ],
    // V1 had `"todowrite": "allow"`; todos are off by default in V2.
    "experimental": {
        "todo": true
    },
    // Migrated from the V1 `permission` map. opencode evaluates the LAST matching rule, so the
    // broad `shell` `*` rule comes first and the narrow ones after it; `*` is the deliberate
    // fallback for a command not listed.
    //
    // `read` is intentionally not listed: V2's base policy already allows reads but keeps a
    // `*.env` "ask" guard, and a blanket `read: allow` would silently widen access to secrets.
    // `list` is not a V2 permission action (discovery tools are allowed by default), and
    // `todowrite` became `experimental.todo` above.
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "& *bash.exe* -c *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "& *pwsh.exe* -Command *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "& *php.exe *",
            "effect": "allow"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "grep",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "echo *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "curl *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "php *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "composer *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "python *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "python3 *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "py *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "rg *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "sh *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pwsh *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "powershell *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Get-*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Set-*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Get-ChildItem *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Copy-Item *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "New-Item *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Remove-Item *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Test-Path *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Set-Content *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Select-Object *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Sort-Object *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Where-Object *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Measure-Object *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "ForEach-Object *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Select-String *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Out-Null *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Out-String *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Start-Sleep *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "Write-Output *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "aws *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "tar *",
            "effect": "allow"
        },
        // V2 allows outside-project paths by default; the V1 config denied them.
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "external_directory",
            "resource": "<__SYSTEM_TEMP_FOLDER__>/opencode/*",
            "effect": "allow"
        }
    ]
}
