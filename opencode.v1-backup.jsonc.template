{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md",
        "BEHAVE.mdc"
    ],
    "formatter": true,
    "skills": {
        // `.agents/skills/` is the single real skill target (see .agents/README.md).
        // There is deliberately no `.opencode/skills/` - a second copy would drift
        // out of sync with the canonical packages, which is what it used to do.
        "paths": [
            ".agents/skills"
        ]
    },
    // The permissions this session was granted, recorded in `permissions-01.md` (also gitignored).
    // opencode evaluates the LAST matching rule, so the broad `*` rules come first and the narrow
    // ones after it; `bash`'s `"*": "ask"` is the deliberate fallback for a command not listed.
    "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow",
        "bash": {
            "*": "ask",
            "echo *": "allow",
            "curl *": "allow",
            "php *": "allow",
            "composer *": "allow",
            "git *": "allow",
            "python *": "allow",
            "python3 *": "allow",
            "py *": "allow",
            "rg *": "allow",
            "sh *": "allow",
            "pwsh *": "allow",
            "powershell *": "allow",
            "Get-*": "allow",
            "Set-*": "allow",
            "Get-ChildItem *": "allow",
            "Copy-Item *": "allow",
            "New-Item *": "allow",
            "Remove-Item *": "allow",
            "Test-Path *": "allow",
            "Set-Content *": "allow",
            "Select-Object *": "allow",
            "Sort-Object *": "allow",
            "Where-Object *": "allow",
            "Measure-Object *": "allow",
            "ForEach-Object *": "allow",
            "Select-String *": "allow",
            "Out-Null *": "allow",
            "Out-String *": "allow",
            "Start-Sleep *": "allow",
            "Write-Output *": "allow",
            "aws *": "allow",
            "tar *": "allow"
        },
        "external_directory": {
            "*": "deny",
            "<__SYSTEM_TEMP_FOLDER__>\\*": "allow"
        }
    }
}
